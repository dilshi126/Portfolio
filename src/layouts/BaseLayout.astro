---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

type Section = 'about' | 'projects' | 'skills';

interface Props {
  title?: string;
  description?: string;
  active?: Section;
}

const {
  title = 'Dilshi Piyumika | QA Engineer',
  description = 'Dilshi Piyumika is a Software Quality Assurance Engineer focused on thoughtful testing, Playwright automation, and quality delivery.',
  active,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111d2a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader active={active} />
    <slot />
    <SiteFooter />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 6rem;
  }

  body {
    margin: 0;
    color: #172433;
    background: #f5f7f5;
    font-family: Inter, "Segoe UI", sans-serif;
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible {
    outline: 3px solid #82b73b;
    outline-offset: 4px;
  }

  ::selection {
    color: #111d2a;
    background: #c9ef81;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      transition-duration: 0.01ms !important;
    }
  }
</style>
