---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    period: 'October 2025 — Present',
    role: 'Software Quality Assurance Engineer',
    company: 'AE Turns (Pvt) Ltd',
    details: [
      'Design and execute end-to-end test cases and scenarios based on functional requirements.',
      'Develop and maintain Playwright automation with TypeScript for regression coverage.',
      'Track defects in Jira and work with developers and stakeholders to support timely resolution.',
      'Support sprint planning, backlog grooming, daily stand-ups, and project progress visibility.',
    ],
  },
  {
    period: 'March 2025 — September 2025',
    role: 'Intern Software Quality Assurance Engineer',
    company: 'CeyDigital Solutions (Pvt) Ltd',
    details: [
      'Performed manual testing on web applications, project management tools, and mobile games.',
      'Created and executed test cases and documented defects with clear, structured details.',
      'Developed automation scripts and collaborated with QA and development teams during Agile sprints.',
    ],
  },
];
---

<BaseLayout
  title="About | Dilshi Piyumika"
  description="Learn about Dilshi Piyumika's QA experience, education, and ISTQB CTFL certification."
  active="about"
>
  <main>
    <section class="page-hero">
      <div class="section-wrap">
        <p class="eyebrow"><span>ABOUT</span> · SOFTWARE QUALITY ASSURANCE ENGINEER</p>
        <h1>Curious by nature.<br /><span>Thorough by practice.</span></h1>
        <p class="hero-copy">
          I’m Dilshi Piyumika, a Bachelor of ICT (Honours) graduate working in software quality
          assurance. I bring hands-on experience in manual testing, automation scripting, defect
          tracking, and Agile project coordination.
        </p>
      </div>
    </section>

    <section class="section-wrap experience-section">
      <div class="section-kicker"><span>01</span><span>EXPERIENCE</span></div>
      <h2>Building quality with the team<span>.</span></h2>
      <div class="timeline">
        {experience.map((job) => (
          <article class="timeline-item">
            <p class="date">{job.period}</p>
            <div>
              <h3>{job.role}</h3>
              <p class="company">{job.company}</p>
              <ul>
                {job.details.map((detail) => <li>{detail}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="education-section">
      <div class="section-wrap education-grid">
        <div>
          <div class="section-kicker"><span>02</span><span>EDUCATION</span></div>
          <h2>Grounded in technology.<br />Driven by quality.</h2>
        </div>
        <article class="credential-card">
          <p class="credential-type">BACHELOR’S DEGREE · 2022—2026</p>
          <h3>Bachelor of Information and Communication Technology (Honours)</h3>
          <p>University of Sri Jayewardenepura</p>
          <span class="gpa">GPA 3.84</span>
        </article>
      </div>
    </section>

    <section class="section-wrap certification-section">
      <div class="section-kicker"><span>03</span><span>CERTIFICATION</span></div>
      <article class="certification-card">
        <span class="cert-mark" aria-hidden="true">✳</span>
        <div>
          <p class="credential-type">ISTQB · CORE · V4.0</p>
          <h2>Certified Tester Foundation Level</h2>
          <p>
            A foundation in testing concepts, test design, test management, defect reporting,
            and the role of testing throughout the software development lifecycle.
          </p>
        </div>
      </article>
    </section>

    <section class="closing">
      <div class="section-wrap closing-inner">
        <h2>Want to see quality in practice?</h2>
        <a href="/projects/">Explore my projects <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .section-wrap {
    width: min(1120px, calc(100% - 3rem));
    margin: 0 auto;
  }

  .page-hero {
    padding: clamp(4.5rem, 9vw, 8rem) 0;
    color: #f7faf6;
    background:
      radial-gradient(ellipse at 86% 20%, rgb(91 126 86 / 20%), transparent 32%),
      #111d2a;
  }

  .eyebrow,
  .section-kicker,
  .credential-type {
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .eyebrow {
    margin: 0 0 1.5rem;
    color: #b6c1ca;
  }

  .eyebrow span {
    color: #c9ef81;
  }

  h1,
  h2 {
    letter-spacing: -0.065em;
    line-height: 1.08;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 5.4rem);
    font-weight: 650;
  }

  h1 span {
    color: #c9ef81;
  }

  .hero-copy {
    max-width: 650px;
    margin: 1.7rem 0 0;
    color: #c1cad1;
    font-size: 1.05rem;
  }

  .experience-section,
  .certification-section {
    padding-top: 6rem;
    padding-bottom: 6rem;
  }

  .section-kicker {
    display: flex;
    gap: 0.75rem;
    color: #718078;
  }

  .section-kicker span:first-child {
    color: #567d2a;
  }

  h2 {
    margin: 1.2rem 0 0;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 620;
  }

  .experience-section > h2 span {
    color: #8fbb51;
  }

  .timeline {
    margin-top: 2rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: minmax(180px, 0.65fr) 1.35fr;
    gap: 2rem;
    padding: 1.7rem 0;
    border-top: 1px solid #dce3dc;
  }

  .date {
    margin: 0;
    color: #65736a;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.72rem;
  }

  .timeline-item h3,
  .credential-card h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .company {
    margin: 0.3rem 0 1rem;
    color: #68756c;
    font-size: 0.85rem;
  }

  .timeline-item ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding-left: 1.15rem;
    color: #56645c;
    font-size: 0.84rem;
  }

  .timeline-item li::marker {
    color: #75a43f;
  }

  .education-section {
    padding: 5.5rem 0;
    background: #e9eee9;
  }

  .education-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 3rem;
  }

  .education-grid h2 {
    max-width: 480px;
  }

  .credential-card {
    padding: 1.6rem;
    border: 1px solid #d8e0d7;
    border-radius: 0.85rem;
    background: #fff;
  }

  .credential-type {
    margin: 0 0 0.65rem;
    color: #6a805e;
    font-size: 0.62rem;
  }

  .credential-card h3 {
    max-width: 420px;
    font-size: 1.35rem;
    line-height: 1.35;
  }

  .credential-card > p:not(.credential-type) {
    margin: 0.5rem 0 1rem;
    color: #65716a;
    font-size: 0.85rem;
  }

  .gpa {
    display: inline-block;
    padding: 0.35rem 0.7rem;
    border-radius: 99px;
    background: #eff5e8;
    color: #456b20;
    font-size: 0.73rem;
    font-weight: 700;
  }

  .certification-card {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 1.2rem;
    margin-top: 1.8rem;
    padding: 1.7rem;
    border: 1px solid #e1e8df;
    border-radius: 0.85rem;
    background: #fff;
  }

  .cert-mark {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 50%;
    background: #c9ef81;
    color: #172433;
  }

  .certification-card h2 {
    margin-top: 0;
    font-size: 1.4rem;
  }

  .certification-card > div > p:last-child {
    max-width: 700px;
    margin: 0.6rem 0 0;
    color: #65716a;
    font-size: 0.84rem;
  }

  .closing {
    padding: 2.2rem 0;
    background: #172433;
    color: #f3f6f1;
  }

  .closing-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .closing h2 {
    margin: 0;
    font-size: clamp(1.3rem, 3vw, 2rem);
  }

  .closing a {
    flex: 0 0 auto;
    color: #c9ef81;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 680px) {
    .section-wrap {
      width: min(100% - 2.4rem, 540px);
    }

    .timeline-item,
    .education-grid {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .experience-section,
    .certification-section {
      padding-top: 4.5rem;
      padding-bottom: 4.5rem;
    }

    .education-section {
      padding: 4.5rem 0;
    }

    .closing-inner {
      align-items: start;
      flex-direction: column;
      padding: 0.5rem 0;
    }
  }
</style>
