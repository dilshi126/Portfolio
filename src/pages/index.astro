---
const email = 'dilshipiyumika@gmail.com';

const projects = [
  {
    number: '01',
    name: 'MyWin',
    type: 'Lottery buying and selling platform',
    summary:
      'Led end-to-end manual testing across core purchase and transaction workflows, then automated repetitive regression scenarios.',
    tools: ['Playwright', 'TypeScript', 'Jira'],
    outcome: 'Zero critical bugs in the production release',
    tone: 'mint',
  },
  {
    number: '02',
    name: 'Worklenz',
    type: 'Project management tool',
    summary:
      'Validated system modules against user workflows and business requirements, combining exploratory testing with browser automation.',
    tools: ['Playwright', 'Selenium', 'Python'],
    outcome: 'Web application · Manual and automated testing',
    tone: 'blue',
  },
  {
    number: '03',
    name: 'Ludo Crush',
    type: 'Telegram-based mobile game',
    summary:
      'Tested gameplay, user interactions, and edge cases to help improve game stability and the overall player experience.',
    tools: ['Mobile testing', 'Exploratory testing'],
    outcome: 'Mobile game · Functional and edge-case coverage',
    tone: 'peach',
  },
];

const experience = [
  {
    period: 'Oct 2025 — Present',
    role: 'Software Quality Assurance Engineer',
    company: 'AE Turns (Pvt) Ltd',
    details: [
      'Design and execute end-to-end test cases and scenarios from functional requirements.',
      'Build and maintain Playwright automation with TypeScript for efficient regression coverage.',
      'Track defects in Jira and collaborate with developers and stakeholders through Agile delivery.',
      'Support sprint planning, backlog refinement, daily stand-ups, and project progress visibility.',
    ],
  },
  {
    period: 'Mar 2025 — Sep 2025',
    role: 'Intern Software Quality Assurance Engineer',
    company: 'CeyDigital Solutions (Pvt) Ltd',
    details: [
      'Performed manual testing for web applications, project management tools, and mobile games.',
      'Created test cases and documented defects with clear steps and expected results.',
      'Developed automation scripts and collaborated with QA and development teams during sprints.',
    ],
  },
];

const skillGroups = [
  {
    title: 'Testing',
    items: 'Functional · Regression · Integration · System · UAT · Exploratory',
  },
  {
    title: 'Automation',
    items: 'Playwright · TypeScript · Selenium WebDriver · Python · PyTest · Appium',
  },
  {
    title: 'API & data',
    items: 'Postman · REST API testing · SQL · Database testing',
  },
  {
    title: 'Quality delivery',
    items: 'Jira · Xray · Agile/Scrum · Test design · Defect lifecycle',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Dilshi Piyumika is a Software Quality Assurance Engineer focused on thoughtful testing, Playwright automation, and quality delivery." />
    <meta name="theme-color" content="#111d2a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Dilshi Piyumika | QA Engineer</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="#home" aria-label="Dilshi Piyumika, home">
        <span class="wordmark-mark" aria-hidden="true">D</span>
        <span>DILSHI PIYUMIKA</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#work">Selected work</a>
        <a href="#experience">Experience</a>
        <a href="#about">About</a>
        <a class="nav-contact" href={`mailto:${email}`}>Get in touch <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main>
      <section class="hero" id="home">
        <div class="hero-inner">
          <div class="hero-copy">
            <p class="eyebrow"><span class="status-dot"></span> SOFTWARE QUALITY ASSURANCE ENGINEER · SRI LANKA</p>
            <h1>Better software<br />starts with <span>better questions.</span></h1>
            <p class="hero-intro">
              I’m Dilshi — an ICT graduate and QA Engineer who brings together careful
              exploratory testing, reliable automation, and clear team communication.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">↓</span></a>
              <a class="button button-quiet" href={`mailto:${email}`}>Let’s connect <span aria-hidden="true">↗</span></a>
            </div>
            <div class="hero-tools" aria-label="Selected tools">
              <span>Playwright</span><span>TypeScript</span><span>Jira</span><span>ISTQB CTFL</span>
            </div>
          </div>
          <aside class="hero-note" aria-label="Professional focus">
            <div class="note-topline"><span>QUALITY, BY DESIGN</span><span>01 / 06</span></div>
            <div class="note-symbol" aria-hidden="true">
              <svg viewBox="0 0 120 120" fill="none">
                <circle cx="60" cy="60" r="44" stroke="currentColor" stroke-width="1.5" />
                <circle cx="60" cy="60" r="29" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 5" />
                <path d="m43 61 11 11 24-27" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <p class="note-label">My focus</p>
            <p class="note-statement">Find risk early.<br />Make quality visible.</p>
            <div class="note-rule"></div>
            <p class="note-foot">Manual insight <span>+</span> thoughtful automation</p>
          </aside>
        </div>
        <div class="hero-index" aria-hidden="true">QUALITY IS A TEAM SPORT</div>
      </section>

      <section class="intro section-wrap" id="about">
        <div class="section-kicker"><span>01</span><span>THE APPROACH</span></div>
        <div class="intro-content">
          <h2>Curious by nature.<br /><span>Thorough by practice.</span></h2>
          <div>
            <p>
              I help teams ship with confidence by translating requirements into meaningful
              tests, surfacing defects clearly, and automating the checks that matter most.
            </p>
            <p>
              From web and mobile testing to sprint coordination, I care about the whole
              product experience — and the people building it.
            </p>
          </div>
        </div>
      </section>

      <section class="work-section section-wrap" id="work">
        <div class="section-heading">
          <div>
            <div class="section-kicker"><span>02</span><span>SELECTED WORK</span></div>
            <h2>Quality in practice<span class="heading-dot">.</span></h2>
          </div>
          <p>Three products. Different users. One goal: dependable experiences.</p>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <article class={`project-card ${project.tone}`}>
              <div class="project-card-top">
                <span class="project-number">{project.number} / CASE STUDY</span>
                <span class="project-arrow" aria-hidden="true">↗</span>
              </div>
              <p class="project-type">{project.type}</p>
              <h3>{project.name}</h3>
              <p class="project-summary">{project.summary}</p>
              <ul class="tag-list" aria-label={`${project.name} tools and methods`}>
                {project.tools.map((tool) => <li>{tool}</li>)}
              </ul>
              <div class="project-outcome"><span aria-hidden="true">↳</span>{project.outcome}</div>
            </article>
          ))}
        </div>
        <p class="privacy-note">
          Project summaries are intentionally high-level; no confidential product data or employer-owned test materials are shared.
        </p>
      </section>

      <section class="experience-section" id="experience">
        <div class="section-wrap">
          <div class="section-heading">
            <div>
              <div class="section-kicker"><span>03</span><span>EXPERIENCE</span></div>
              <h2>Growing through<br />every release<span class="heading-dot">.</span></h2>
            </div>
            <p>Hands-on quality work, grounded in collaboration and continuous learning.</p>
          </div>
          <div class="timeline">
            {experience.map((job, index) => (
              <article class="timeline-item">
                <div class="timeline-marker" aria-hidden="true">{index === 0 ? '●' : '○'}</div>
                <div class="timeline-date">{job.period}</div>
                <div class="timeline-content">
                  <h3>{job.role}</h3>
                  <p class="company">{job.company}</p>
                  <ul>
                    {job.details.map((detail) => <li>{detail}</li>)}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="skills-section section-wrap">
        <div class="section-heading">
          <div>
            <div class="section-kicker"><span>04</span><span>TOOLKIT</span></div>
            <h2>Skills for the<br />full quality cycle<span class="heading-dot">.</span></h2>
          </div>
          <p>The right technique for the risk, the product, and the team.</p>
        </div>
        <div class="skill-grid">
          {skillGroups.map((group) => (
            <article class="skill-card">
              <span class="skill-mark" aria-hidden="true">✳</span>
              <h3>{group.title}</h3>
              <p>{group.items}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="education-section">
        <div class="section-wrap education-inner">
          <div>
            <div class="section-kicker"><span>05</span><span>FOUNDATION</span></div>
            <h2>Learning that<br />moves quality forward.</h2>
          </div>
          <div class="education-list">
            <article>
              <span class="education-icon" aria-hidden="true">✳</span>
              <div>
                <p class="education-label">CERTIFICATION</p>
                <h3>ISTQB Certified Tester Foundation Level</h3>
                <p>CTFL · Core · v4.0</p>
              </div>
            </article>
            <article>
              <span class="education-icon" aria-hidden="true">◎</span>
              <div>
                <p class="education-label">EDUCATION · 2022—2026</p>
                <h3>Bachelor of Information and Communication Technology (Honours)</h3>
                <p>University of Sri Jayewardenepura · GPA 3.84</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="contact-section section-wrap">
        <div class="section-kicker"><span>06</span><span>YOUR NEXT RELEASE</span></div>
        <div class="contact-inner">
          <h2>Let’s make quality<br /><span>everyone’s business.</span></h2>
          <a class="button button-primary contact-button" href={`mailto:${email}`}>
            Email Dilshi <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <a class="wordmark footer-wordmark" href="#home">
        <span class="wordmark-mark" aria-hidden="true">D</span>
        <span>DILSHI PIYUMIKA</span>
      </a>
      <p>Thoughtful testing. Better releases.</p>
      <a href="#home">Back to top ↑</a>
      <span class="copyright">© {new Date().getFullYear()} Dilshi Piyumika</span>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 6rem;
  }

  :global(body) {
    margin: 0;
    color: #172433;
    background: #f5f7f5;
    font-family: Inter, "Segoe UI", sans-serif;
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(a:focus-visible) {
    outline: 3px solid #82b73b;
    outline-offset: 4px;
  }

  :global(::selection) {
    color: #111d2a;
    background: #c9ef81;
  }

  .site-header {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(1.25rem, 6vw, 6rem);
    background: #fff;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.13em;
  }

  .wordmark-mark {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 50%;
    background: #c9ef81;
    color: #172433;
    font-size: 0.95rem;
    letter-spacing: 0;
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    color: #5c6872;
    font-size: 0.82rem;
  }

  .site-header nav a,
  .site-footer a {
    transition: color 160ms ease;
  }

  .site-header nav a:hover,
  .site-footer a:hover {
    color: #507a22;
  }

  .site-header nav .nav-contact {
    padding: 0.58rem 0.9rem;
    border: 1px solid #dfe5df;
    border-radius: 99px;
    color: #172433;
    font-weight: 700;
  }

  .nav-contact span {
    padding-left: 0.3rem;
  }

  .hero {
    position: relative;
    overflow: hidden;
    color: #f7faf6;
    background:
      radial-gradient(ellipse at 86% 20%, rgb(91 126 86 / 20%), transparent 32%),
      #111d2a;
  }

  .hero-inner {
    display: grid;
    width: min(1120px, calc(100% - 3rem));
    min-height: 610px;
    grid-template-columns: minmax(0, 1.45fr) minmax(260px, 0.65fr);
    align-items: center;
    gap: clamp(2rem, 8vw, 7rem);
    margin: 0 auto;
    padding: 6rem 0 7rem;
  }

  .eyebrow,
  .section-kicker,
  .note-topline,
  .project-number,
  .education-label {
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 1.7rem;
    color: #b6c1ca;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #c9ef81;
    box-shadow: 0 0 0 5px rgb(201 239 129 / 12%);
  }

  .hero h1 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(3rem, 6.8vw, 5.7rem);
    font-weight: 650;
    letter-spacing: -0.07em;
    line-height: 0.99;
  }

  .hero h1 span,
  .contact-inner h2 span {
    color: #c9ef81;
  }

  .hero-intro {
    max-width: 540px;
    margin: 1.8rem 0 0;
    color: #c1cad1;
    font-size: 1.05rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 0.7rem 1.1rem;
    border: 1px solid transparent;
    border-radius: 99px;
    font-size: 0.84rem;
    font-weight: 750;
    transition: transform 160ms ease, background 160ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    color: #15202a;
    background: #c9ef81;
  }

  .button-primary:hover {
    background: #d7f5a1;
  }

  .button-quiet {
    border-color: #53606d;
    color: #f7faf6;
  }

  .button-quiet:hover {
    background: rgb(255 255 255 / 8%);
  }

  .hero-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 3rem;
  }

  .hero-tools span,
  .tag-list li {
    padding: 0.35rem 0.65rem;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 99px;
    color: #ccd4da;
    font-size: 0.7rem;
  }

  .hero-note {
    max-width: 330px;
    justify-self: end;
    padding: 1.25rem;
    border: 1px solid rgb(201 239 129 / 35%);
    border-radius: 1rem;
    background: rgb(255 255 255 / 4%);
    transform: rotate(2deg);
  }

  .note-topline {
    display: flex;
    justify-content: space-between;
    color: #aeb9c1;
    font-size: 0.58rem;
  }

  .note-symbol {
    display: grid;
    width: 100%;
    height: 178px;
    margin: 0.8rem 0 1rem;
    place-items: center;
    border-radius: 0.65rem;
    color: #c9ef81;
    background: linear-gradient(140deg, rgb(201 239 129 / 13%), rgb(201 239 129 / 2%));
  }

  .note-symbol svg {
    width: 118px;
  }

  .note-label {
    margin: 0;
    color: #aeb9c1;
    font-size: 0.74rem;
  }

  .note-statement {
    margin: 0.35rem 0 1.1rem;
    font-size: 1.5rem;
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1.25;
  }

  .note-rule {
    height: 1px;
    background: rgb(255 255 255 / 15%);
  }

  .note-foot {
    margin: 0.8rem 0 0;
    color: #aeb9c1;
    font-size: 0.69rem;
  }

  .note-foot span {
    padding: 0 0.2rem;
    color: #c9ef81;
  }

  .hero-index {
    position: absolute;
    right: 2rem;
    bottom: 1.4rem;
    color: #85929b;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.59rem;
    letter-spacing: 0.18em;
  }

  .section-wrap {
    width: min(1120px, calc(100% - 3rem));
    margin: 0 auto;
  }

  .intro {
    padding-top: 7rem;
    padding-bottom: 7rem;
  }

  .section-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #718078;
  }

  .section-kicker span:first-child {
    color: #567d2a;
  }

  .intro-content {
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    gap: 4rem;
    align-items: start;
    margin-top: 1.6rem;
  }

  .intro h2,
  .section-heading h2,
  .contact-inner h2 {
    margin: 0;
    color: #172433;
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-weight: 620;
    letter-spacing: -0.065em;
    line-height: 1.08;
  }

  .intro h2 span {
    color: #7d8981;
  }

  .intro-content > div {
    padding-top: 0.2rem;
    color: #5e6a71;
  }

  .intro-content p {
    margin: 0 0 1rem;
  }

  .work-section {
    padding-bottom: 7rem;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.2rem;
  }

  .section-heading h2 {
    margin-top: 1.3rem;
  }

  .section-heading > p {
    max-width: 330px;
    margin: 0 0 0.3rem;
    color: #67737a;
    font-size: 0.9rem;
  }

  .heading-dot {
    color: #8fbb51;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .project-card {
    display: flex;
    min-height: 380px;
    flex-direction: column;
    padding: 1.3rem;
    border: 1px solid #e5e9e4;
    border-radius: 0.85rem;
    background: #fff;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 35px rgb(23 36 51 / 8%);
  }

  .project-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .project-number {
    color: #78847c;
    font-size: 0.58rem;
  }

  .project-arrow {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border-radius: 50%;
    color: #263542;
    background: #f0f3ef;
  }

  .project-type {
    margin: 1.45rem 0 0.35rem;
    color: #69756e;
    font-size: 0.72rem;
  }

  .project-card h3 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 650;
    letter-spacing: -0.06em;
  }

  .project-summary {
    margin: 0.8rem 0 1.1rem;
    color: #5e6a71;
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: auto 0 1rem;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    border-color: #e0e6df;
    color: #48564d;
    font-size: 0.64rem;
  }

  .project-outcome {
    display: flex;
    gap: 0.45rem;
    padding-top: 0.85rem;
    border-top: 1px solid #e8ece8;
    color: #47574d;
    font-size: 0.7rem;
    font-weight: 650;
  }

  .project-outcome span {
    color: #6d963c;
  }

  .mint { border-top: 3px solid #a9d574; }
  .blue { border-top: 3px solid #9bb9d3; }
  .peach { border-top: 3px solid #e2b393; }

  .privacy-note {
    margin: 1rem 0 0;
    color: #7b8580;
    font-size: 0.72rem;
  }

  .experience-section {
    padding: 6.5rem 0 7rem;
    background: #e9eee9;
  }

  .timeline {
    margin-top: 3rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 26px minmax(140px, 0.55fr) 1.45fr;
    gap: 1.2rem;
    padding: 1.7rem 0;
    border-top: 1px solid #d2dbd2;
  }

  .timeline-marker {
    padding-top: 0.1rem;
    color: #5d8a2f;
    font-size: 0.85rem;
  }

  .timeline-date {
    color: #65736a;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.7rem;
  }

  .timeline-content h3 {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .company {
    margin: 0.25rem 0 1rem;
    color: #68756c;
    font-size: 0.83rem;
  }

  .timeline-content ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding-left: 1.1rem;
    color: #56645c;
    font-size: 0.81rem;
  }

  .timeline-content li::marker {
    color: #75a43f;
  }

  .skills-section {
    padding-top: 7rem;
    padding-bottom: 7rem;
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.9rem;
  }

  .skill-card {
    padding: 1.2rem;
    border: 1px solid #e2e8e1;
    border-radius: 0.7rem;
    background: #fff;
  }

  .skill-mark {
    color: #78a746;
    font-size: 1.1rem;
  }

  .skill-card h3 {
    margin: 0.8rem 0 0.45rem;
    font-size: 0.94rem;
  }

  .skill-card p {
