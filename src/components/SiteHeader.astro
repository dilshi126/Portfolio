---
type Section = 'about' | 'projects' | 'skills';

interface Props {
  active?: Section;
}

const { active } = Astro.props;
---

<header class="site-header">
  <a class="wordmark" href="/about/" aria-label="About Dilshi Piyumika">
    <span class="wordmark-mark" aria-hidden="true">D</span>
    <span>DILSHI PIYUMIKA</span>
  </a>
  <nav aria-label="Main navigation">
    <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>About</a>
    <a href="/projects/" aria-current={active === 'projects' ? 'page' : undefined}>Projects</a>
    <a href="/skills/" aria-current={active === 'skills' ? 'page' : undefined}>Skills</a>
    <a class="nav-contact" href="mailto:dilshipiyumika@gmail.com">Get in touch <span aria-hidden="true">↗</span></a>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(1.25rem, 6vw, 6rem);
    background: #fff;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: #172433;
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-decoration: none;
  }

  .wordmark-mark {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 50%;
    background: #c9ef81;
    color: #172433;
    font-size: 0.95rem;
    letter-spacing: 0;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    color: #5c6872;
    font-size: 0.82rem;
  }

  nav a {
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: #507a22;
  }

  nav .nav-contact {
    padding: 0.58rem 0.9rem;
    border: 1px solid #dfe5df;
    border-radius: 99px;
    color: #172433;
    font-weight: 700;
  }

  .nav-contact span {
    padding-left: 0.3rem;
  }

  @media (max-width: 680px) {
    .site-header {
      min-height: 68px;
      padding: 0 1.2rem;
    }

    nav {
      gap: 0.8rem;
      font-size: 0.71rem;
    }

    nav a:nth-child(3) {
      display: none;
    }

    nav .nav-contact {
      padding: 0.45rem 0.7rem;
    }

    .wordmark {
      gap: 0.5rem;
      font-size: 0.64rem;
    }
  }
</style>
